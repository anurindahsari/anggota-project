# Database
DATABASE_URL=postgresql://user:password@localhost:5432/anggota_db

# JWT untuk session token
JWT_SECRET=ganti_dengan_random_string_panjang
JWT_EXPIRES_IN=30d

# Payment gateway (pilih salah satu, atau siapkan dua-duanya)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

XENDIT_SECRET_KEY=

# WhatsApp API (Fonnte / Wablas, bukan Meta langsung)
WA_API_URL=https://api.fonnte.com/send
WA_API_TOKEN=

# Upload bukti transfer manual
UPLOAD_DIR=./uploads

PORT=4000
