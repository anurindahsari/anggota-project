:root {
  --bg: #FAFBFC;
  --surface: #FFFFFF;
  --border: #E4E7EE;
  --border-strong: #CBD1DE;
  --text-primary: #10131F;
  --text-secondary: #656D80;
  --text-muted: #99A0B3;
  --brand: #355FF7;
  --brand-hover: #2A4DD1;
  --brand-soft: #EEF1FF;
  --success: #157F3C;
  --success-bg: #E9F9EE;
  --danger: #BB2020;
  --danger-bg: #FDEEEE;
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 18px;
}

* { box-sizing: border-box; }

html, body {
  background: var(--bg);
  color: var(--text-primary);
  margin: 0;
  padding: 0;
  -webkit-font-smoothing: antialiased;
}

h1, h2, h3, p { margin: 0; }

a { color: inherit; text-decoration: none; }

/* Layout */
.page {
  max-width: 480px;
  margin: 0 auto;
  padding: 32px 20px 64px;
}
.page-wide {
  max-width: 720px;
  margin: 0 auto;
  padding: 32px 20px 64px;
}

.header {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 32px;
}
.header-mark {
  width: 32px;
  height: 32px;
  object-fit: contain;
  flex-shrink: 0;
}
.header-word {
  font-weight: 700;
  font-size: 14px;
  color: var(--text-primary);
  letter-spacing: 0.02em;
  line-height: 1.25;
}
.header-sub {
  font-weight: 600;
  font-size: 13px;
  color: var(--text-secondary);
  letter-spacing: 0.16em;
  line-height: 1.25;
  margin-top: 1px;
}

.page-title {
  font-size: 22px;
  font-weight: 600;
  letter-spacing: -0.02em;
  margin-bottom: 4px;
}
.page-subtitle {
  font-size: 14px;
  color: var(--text-secondary);
  margin-bottom: 24px;
}

/* Card */
.card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 20px;
}

/* Stat grid */
.stat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  margin-bottom: 28px;
}
.stat-grid.stat-grid-2 { grid-template-columns: repeat(2, 1fr); }
.stat-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 16px;
}
.stat-label {
  font-size: 12.5px;
  color: var(--text-secondary);
  margin-bottom: 6px;
}
.stat-value {
  font-size: 24px;
  font-weight: 700;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
}
.stat-value.success { color: var(--success); }
.stat-value.danger { color: var(--danger); }

/* List */
.list {
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: var(--surface);
}
.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding: 16px 18px;
}
.list-item + .list-item { border-top: 1px solid var(--border); }
.list-item-title {
  font-size: 14.5px;
  font-weight: 500;
  margin-bottom: 2px;
}
.list-item-meta {
  font-size: 13px;
  color: var(--text-secondary);
}

/* Badge */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 4px 11px;
  border-radius: 999px;
  font-size: 12.5px;
  font-weight: 500;
  white-space: nowrap;
}
.badge-success { background: var(--success-bg); color: var(--success); }
.badge-danger { background: var(--danger-bg); color: var(--danger); }

/* Form elements */
.field { margin-bottom: 18px; }
.label {
  display: block;
  font-size: 13px;
  font-weight: 500;
  color: var(--text-secondary);
  margin-bottom: 7px;
}
.input, select.input, textarea.input {
  width: 100%;
  font-family: inherit;
  font-size: 15px;
  padding: 12px 14px;
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-sm);
  background: var(--surface);
  color: var(--text-primary);
  transition: border-color 0.15s ease;
}
.input:focus {
  outline: none;
  border-color: var(--brand);
}
textarea.input { resize: vertical; font-family: inherit; }

/* Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-family: inherit;
  font-size: 14.5px;
  font-weight: 600;
  padding: 12px 20px;
  border-radius: var(--radius-sm);
  border: 1px solid transparent;
  cursor: pointer;
  transition: background 0.15s ease, border-color 0.15s ease, opacity 0.15s ease;
}
.btn:disabled { opacity: 0.55; cursor: not-allowed; }
.btn-full { width: 100%; }
.btn-primary { background: var(--brand); color: #fff; }
.btn-primary:hover:not(:disabled) { background: var(--brand-hover); }
.btn-secondary { background: var(--surface); color: var(--text-primary); border-color: var(--border-strong); }
.btn-secondary:hover:not(:disabled) { border-color: var(--text-secondary); }
.btn-danger { background: var(--danger); color: #fff; }
.btn-sm { padding: 8px 14px; font-size: 13px; }
.btn-selected { background: var(--brand-soft); border-color: var(--brand); color: var(--brand); }

/* Alerts */
.alert {
  border-radius: var(--radius-md);
  padding: 14px 16px;
  font-size: 13.5px;
  margin-bottom: 16px;
}
.alert-danger { background: var(--danger-bg); color: var(--danger); }
.alert-success { background: var(--success-bg); color: var(--success); }
.alert-muted { background: var(--brand-soft); color: var(--brand); }

.text-muted { color: var(--text-muted); }
.text-secondary { color: var(--text-secondary); }
.text-center { text-align: center; }
.mt-24 { margin-top: 24px; }
.stack { display: flex; flex-direction: column; gap: 10px; }
.row { display: flex; gap: 8px; }
.row-between { display: flex; justify-content: space-between; align-items: center; }

/* Public nav */
.public-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  max-width: 960px;
  margin: 0 auto;
  padding: 20px 20px;
  flex-wrap: wrap;
}
.public-nav-brand {
  display: flex;
  align-items: center;
  gap: 10px;
}
.public-nav-links {
  display: flex;
  gap: 4px;
  flex: 1;
  justify-content: center;
}
.public-nav-link {
  font-size: 14px;
  font-weight: 500;
  color: var(--text-secondary);
  padding: 8px 14px;
  border-radius: var(--radius-sm);
}
.public-nav-link:hover { color: var(--text-primary); background: var(--surface); }
.public-nav-link.active { color: var(--brand); background: var(--brand-soft); }

.hero {
  max-width: 960px;
  margin: 0 auto;
  padding: 56px 20px 40px;
  display: flex;
  align-items: flex-start;
  gap: 48px;
  flex-wrap: wrap;
}
.hero-text {
  flex: 1 1 320px;
  min-width: 280px;
}
.hero-eyebrow {
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--brand);
  margin-bottom: 12px;
}
.hero h1 {
  font-size: 32px;
  font-weight: 700;
  letter-spacing: -0.02em;
  margin-bottom: 16px;
}
.hero p {
  font-size: 15.5px;
  color: var(--text-secondary);
  max-width: 440px;
  margin: 0 0 24px;
  line-height: 1.5;
  text-align: justify;
}
.hero-illustration {
  flex: 0 0 220px;
  display: flex;
  justify-content: center;
}
@media (max-width: 680px) {
  .hero { flex-direction: column; padding-top: 24px; gap: 24px; }
  .hero p { text-align: left; }
  .hero-text, .hero-photo { flex-basis: auto; }
}

.feature-section {
  background: var(--surface);
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  padding: 8px 20px 16px;
}
.feature-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
  max-width: 960px;
  margin: 0 auto;
}
@media (max-width: 680px) {
  .feature-grid { grid-template-columns: 1fr; }
}
.feature-card {
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 20px 18px;
  text-align: left;
}
.feature-icon {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background: var(--brand-soft);
  color: var(--brand);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  font-weight: 700;
  margin-bottom: 12px;
}
.feature-title { font-size: 14.5px; font-weight: 600; margin-bottom: 4px; }
.feature-desc { font-size: 13px; color: var(--text-secondary); line-height: 1.5; }

.site-footer {
  max-width: 960px;
  margin: 0 auto;
  padding: 10px 20px 24px;
  text-align: center;
  color: var(--text-muted);
  font-size: 12.5px;
}

.content-page {
  max-width: 640px;
  margin: 0 auto;
  padding: 8px 20px 64px;
}
.content-page h2 {
  font-size: 18px;
  font-weight: 600;
  letter-spacing: -0.01em;
  margin: 32px 0 10px;
}
.content-page h2:first-child { margin-top: 0; }
.content-page p {
  font-size: 14.5px;
  line-height: 1.7;
  color: var(--text-secondary);
  margin-bottom: 10px;
}
.content-page ul { margin: 0 0 10px; padding-left: 20px; }
.content-page li {
  font-size: 14.5px;
  line-height: 1.7;
  color: var(--text-secondary);
  margin-bottom: 4px;
}

/* Top nav (halaman publik) */
.topnav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 0;
  border-bottom: 1px solid var(--border);
  margin-bottom: 0;
}
.topnav-links {
  display: flex;
  align-items: center;
  gap: 28px;
}
.topnav-link {
  font-size: 14px;
  font-weight: 500;
  color: var(--text-secondary);
}
.topnav-link.active { color: var(--brand); }
.topnav .header { margin-bottom: 0; }

/* Hero */
.hero {
  padding: 48px 20px 4px;
  text-align: left;
}
.hero-title {
  font-size: 36px;
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1.15;
  max-width: 620px;
  margin-bottom: 16px;
}
.hero-subtitle {
  font-size: 16px;
  color: var(--text-secondary);
  max-width: 520px;
  margin-bottom: 28px;
  line-height: 1.6;
}
.feature-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin: 40px 0 64px;
}
.feature-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 22px;
}
.feature-card-title {
  font-size: 15px;
  font-weight: 600;
  margin-bottom: 6px;
}
.feature-card-desc {
  font-size: 13.5px;
  color: var(--text-secondary);
  line-height: 1.5;
}
.section-title {
  font-size: 20px;
  font-weight: 600;
  letter-spacing: -0.01em;
  margin-bottom: 10px;
}
.prose p {
  font-size: 14.5px;
  line-height: 1.7;
  color: var(--text-secondary);
  margin-bottom: 14px;
}

@media (max-width: 640px) {
  .topnav-links { gap: 16px; }
  .hero-title { font-size: 26px; }
  .feature-grid { grid-template-columns: 1fr; }
}


/* ===== Perbaikan responsif: HP, iPad, laptop ===== */
.hero-banner-img {
  width: 100%;
  height: clamp(140px, 24vw, 260px);
  object-fit: cover;
  display: block;
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
  max-width: 960px;
  margin: 0 auto;
}
@media (max-width: 900px) {
  .feature-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 640px) {
  .feature-grid { grid-template-columns: 1fr; }
}

@media (max-width: 900px) {
  .public-nav { justify-content: center; text-align: center; }
  .public-nav-links { flex: 1 1 100%; order: 3; }
}


/* Foto hero di samping teks */
.hero-photo {
  flex: 1 1 320px;
  min-width: 280px;
}
.hero-photo-img {
  width: 100%;
  height: clamp(180px, 22vw, 320px);
  object-fit: cover;
  border-radius: 18px;
  display: block;
}

/* Perbaikan final: pastikan menang dari semua definisi .hero-text/.hero-photo di atas */
@media (max-width: 680px) {
  .hero-text, .hero-photo { flex-basis: auto; }
}
